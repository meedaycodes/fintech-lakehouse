# Python virtual environment
finenv/
venv/
.venv/
__pycache__/
*.pyc

# Local Unity Catalog secrets - contains real OAuth client-id/secret and is
# (re)generated per-boot. Copy server.properties.example to get started.
docker/etc/conf/server.properties
docker/etc/conf/token.txt

