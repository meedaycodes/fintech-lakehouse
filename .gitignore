data/raw/*
!data/raw/.gitkeep

# Delta table files (regenerate via bronze_ingest.py / silver_transform.py)
data/lakehouse/

# Rows that failed validation in silver_transform.py
data/quarantine/

# Terraform
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Test / coverage artifacts
.pytest_cache/
.coverage
